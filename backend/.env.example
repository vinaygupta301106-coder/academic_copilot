MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DB=academic_copilot_db

NEO4J_URI=neo4j+ssc://YOUR_INSTANCE.databases.neo4j.io
NEO4J_USERNAME=YOUR_NEO4J_USERNAME
NEO4J_PASSWORD=your_neo4j_password

# Local Ollama only — no OpenAI API key is required.
LLM_PROVIDER=ollama
OLLAMA_MODEL=qwen2.5:0.5b

# Qwen is intentionally run with zero GPU layers for this laptop-friendly setup.
OLLAMA_NUM_PREDICT=250
OLLAMA_NUM_CTX=2048
OLLAMA_KEEP_ALIVE=5m

# Maximum natural-language Ollama questions per student per calendar day.
# Deterministic academic-rule answers do not consume this limit.
COPILOT_DAILY_LIMIT=15
